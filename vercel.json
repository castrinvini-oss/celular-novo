{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node",
      "config": { "includeFiles": ["backend/**"] }
    },
    {
      "src": "frontend/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/index.js" },
    { "src": "/assets/(.*)", "dest": "/frontend/assets/$1" },
    { "src": "/admin/?", "dest": "/frontend/admin/index.html" },
    { "src": "/(.*)", "dest": "/frontend/index.html" }
  ],
  "crons": [
    {
      "path": "/api/cron/reconcile",
      "schedule": "0 4 * * *"
    }
  ]
}
