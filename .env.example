# ==========================================================================
#  CELULAR NOVO - Campanha de doacoes via Pix
#  Copie este arquivo para ".env" e preencha com os seus dados reais.
#  NUNCA versione o arquivo .env (ele ja esta no .gitignore).
# ==========================================================================

# --------------------------------------------------------------------------
# Servidor
# --------------------------------------------------------------------------
NODE_ENV=development
PORT=3000

# URL publica da aplicacao (sem barra no final). Usada para montar a URL do
# webhook quando MISTICPAY_WEBHOOK_URL nao for informada.
PUBLIC_BASE_URL=http://localhost:3000

# Segredo usado para assinar o cookie de sessao do painel administrativo.
# Gere um valor aleatorio forte, por exemplo:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=troque-este-valor-por-uma-string-aleatoria-longa

# Caminho do banco SQLite (relativo a raiz do projeto ou absoluto).
DATABASE_FILE=./data/campanha.db

# Quando a aplicacao roda atras de um proxy/CDN (Nginx, Render, Railway,
# Cloudflare), defina quantos proxies existem na frente para que o
# rate limiting enxergue o IP real. 0 = sem proxy.
TRUST_PROXY=0

# --------------------------------------------------------------------------
# MisticPay - https://docs.misticpay.com/
# --------------------------------------------------------------------------
# URL base da API (normalmente nao precisa mudar).
MISTICPAY_API_URL=https://api.misticpay.com

# >>> FORMA RECOMENDADA DE AUTENTICACAO <<<
# Chave de acesso criada no painel da MisticPay em: API -> Chaves de Acesso.
# O par pk_.../sk_... viaja no header "Authorization: Basic base64(pk:sk)".
# O sk_ so e exibido UMA vez, no momento da criacao.
MISTICPAY_PUBLIC_KEY=pk_xxxxxxxxxxxxxxxxxxxxxxxx
MISTICPAY_SECRET_KEY=sk_xxxxxxxxxxxxxxxxxxxxxxxx

# >>> AUTENTICACAO LEGADA (ci/cs) <<<
# Continua funcionando apenas em /transactions/create e /transactions/check e
# sera DESLIGADA em 30/09/2026 (conforme a documentacao oficial).
# Preencha somente se voce ainda nao migrou para a chave de acesso acima.
MISTICPAY_CLIENT_ID=
MISTICPAY_CLIENT_SECRET=

# URL completa que a MisticPay vai chamar quando o status da transacao mudar.
# Precisa ser publica e acessivel pela internet (em producao, use HTTPS).
# Inclua o token secreto no final do caminho - veja MISTICPAY_WEBHOOK_TOKEN.
# Ex.: https://suacampanha.com.br/api/webhooks/misticpay/SEU_TOKEN
MISTICPAY_WEBHOOK_URL=

# Token secreto aceito pelo endpoint de webhook. Funciona como uma senha na
# propria URL, ja que a MisticPay nao assina os webhooks.
# Gere com: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
MISTICPAY_WEBHOOK_TOKEN=troque-este-token-do-webhook

# --------------------------------------------------------------------------
# Regras da campanha (o valor da meta tambem pode ser alterado no /admin)
# --------------------------------------------------------------------------
# Valores em REAIS.
CAMPAIGN_GOAL=2000
DONATION_MIN=1
DONATION_MAX=1000

# Minutos ate uma cobranca Pix nao paga ser marcada como EXPIRED.
PIX_EXPIRATION_MINUTES=30
